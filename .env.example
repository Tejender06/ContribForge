# ContribForge Environment Configuration

# Optional: GitHub Personal Access Token (classic with 'repo' scope)
# If left blank, ContribForge automatically uses its built-in offline demo catalog (100% resilient for hackathon presentations)
GITHUB_TOKEN=

# Optional: TrueFoundry AI Gateway / LLM API Key (if running live model provider in TrueForge)
TRUEFOUNDRY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server Ports
PORT=4000
TRUEFORGE_PORT=8790
